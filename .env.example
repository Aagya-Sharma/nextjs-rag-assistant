# Embeddings — free tier, used regardless of which chat provider you pick.
VOYAGE_API_KEY=pa-...

# Which model answers questions: "anthropic" (Claude, paid) or "gemini" (free tier).
CHAT_PROVIDER=anthropic

# Needed only when CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Needed only when CHAT_PROVIDER=gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Optional override, defaults to gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
